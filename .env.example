# Market data and simulated/live execution
# OpenD must be running and logged in. Keep the gateway bound to localhost.
MOOMOO_HOST=127.0.0.1
MOOMOO_PORT=11111
# Optional, used only by ./opend.sh on macOS. Do not use a real personal path here.
# OPEND_DIR=/path/to/folder/containing/OpenD.app

WATCH_SYMBOL=SPCX
WATCH_BENCHMARK=QQQ
# false is watch-only. Set true only after validating the dashboard and risk settings.
AUTO_TRADE=false
# Keep SIMULATE until you have deliberately reviewed live-order behavior.
MOOMOO_TRADE_ENV=SIMULATE
# Common values depend on region/account; FUTUSG is the project default.
MOOMOO_SECURITY_FIRM=FUTUSG

# TypeSafe Jev: evaluated every five seconds while fresh market data is available.
# Create a key at https://console.typesafe.ai/keys. Never commit your populated .env.
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest
# shadow displays and records Jev without affecting orders; enforce blocks entries that fail the gate.
JEV_ENTRY_GATE_MODE=shadow
JEV_MIN_UP_PROBABILITY=0.60
JEV_MIN_QUALITY_PROBABILITY=0.55
JEV_MAX_STOP_FIRST_PROBABILITY=0.45
JEV_MAX_GATE_AGE_SECONDS=15
JEV_MAX_QUOTE_AGE_SECONDS=60
JEV_TIMEOUT_SECONDS=4
JEV_RECENT_BARS=30

# Deterministic risk controls. Fractions are shares of the account (0.01 is one percent);
# a value outside its safe range refuses to start with the variable named.
RISK_FRACTION=0.01
MAX_POSITION_FRACTION=0.20
MAX_TRADES_PER_DAY=6
MAX_DAILY_LOSS_FRACTION=0.02
ENTRY_TIMEOUT_SECONDS=60
FEE_PER_ORDER=1.10
MIN_GAIN_TO_FEE_RATIO=3.0
SIZING_EQUITY_CAP=5000
# Entries, stops, and targets need an exchange quote younger than this; the session cutoff exit does not.
MAX_QUOTE_AGE_SECONDS=60
